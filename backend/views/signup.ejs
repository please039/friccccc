
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<link rel="icon" href="/assets/firc.png.avif" type="image/svg+xml">
<link rel="stylesheet" href="/vendor/bootstrap.min.css">
<link rel="stylesheet" href="/css/cs.css">
<title>Sign Up - Fricshop.com</title>
</head>
<body>

<main class="content-wrap">

  <!-- navbar -->
  <nav class="navbar navbar-expand-lg navbar-light bg-light position-relative py-4">
    <div class="container">
      <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
        <span class="navbar-toggler-icon"></span>
      </button>

      <div class="collapse navbar-collapse" id="navbarNav">
        <ul class="navbar-nav ms-0">
          <li class="nav-item"><a class="nav-link" href="/">HOME</a></li>
          <li class="nav-item"><a class="nav-link" href="/shop">SHOP</a></li>
          <li class="nav-item"><a class="nav-link" href="/dropupdates.html">DROP UPDATES</a></li>
          <li class="nav-item"><a class="nav-link" href="/orderfaq.html">ORDERS FAQS</a></li>
        </ul>
      </div>

      <ul class="navbar-nav ms-0">
        <li class="nav-item"><a class="nav-link" href="/login">LOGIN</a></li>
        <li class="nav-item"><a class="nav-link active" href="/signup">SIGN UP</a></li>
      </ul>

      <a class="navbar-brand position-absolute top-50 start-50 translate-middle" href="/">
        <img src="/assets/firc.png.avif" alt="Fricshop Logo" width="150" height="75">
      </a>
    </div>
  </nav>

  <!-- minibar -->
  <div class="bg-dark text-white text-center py-2">
    International orders may be subject to local customs duties or import taxes upon delivery.
  </div>

  <!-- signup card -->
  <div class="auth-card">
    <h1 class="auth-title">SIGN UP</h1>

    <p class="auth-desc">
      Join the pond! Create an account to shop<br>
      Fric's drops and manage your orders.
    </p>

    <form action="/signup" method="POST" id="signupForm">

      <label for="signupName" class="auth-label">Name</label>
      <input
        type="text"
        id="signupName"
        name="name"
        class="auth-input"
        placeholder="Enter your name"
        required
      >

      <label for="signupEmail" class="auth-label">Email</label>
      <input
        type="email"
        id="signupEmail"
        name="email"
        class="auth-input"
        placeholder="Enter your email"
        pattern="[^@\s]+@gmail\.com"
        title="Use a Gmail address ending in @gmail.com"
        required
      >

      <label for="signupPassword" class="auth-label">Password</label>
      <input
        type="password"
        id="signupPassword"
        name="password"
        class="auth-input"
        placeholder="Create a password"
        minlength="8"
        required
      >

      <label for="signupConfirm" class="auth-label">Confirm Password</label>
      <input
        type="password"
        id="signupConfirm"
        name="confirmPassword"
        class="auth-input"
        placeholder="Re-enter your password"
        minlength="8"
        required
      >

      <button type="submit" class="auth-btn">SIGN UP</button>
    </form>

    <p class="auth-switch">
      Already have an account? <a href="/login">Log in</a>
    </p>
  </div>

</main>

<!-- footer -->
<footer class="footer">
  <div class="container">
    <div class="row">

      <div class="col-md-4 mb-3">
        <h5 class="text-white">Fricshop</h5>
        <p class="text-white">Made With love by Dric & The community</p>
      </div>

      <div class="col-md-4 mb-3">
        <h5 class="text-white">Menu</h5>
        <ul class="list-unstyled">
          <li><a href="/" class="text-white text-decoration-none">Home</a></li>
          <li><a href="/shop" class="text-white text-decoration-none">Shop</a></li>
          <li><a href="/dropupdates.html" class="text-white text-decoration-none">Drop Updates</a></li>
          <li><a href="/orderfaq.html" class="text-white text-decoration-none">Orders FAQs</a></li>
        </ul>
      </div>

      <div class="col-md-4 mb-3">
        <h5 class="text-white">Contact</h5>
        <p class="text-white">Email: support@fricshop.com</p>
        <div>
          <a href="https://www.instagram.com/fric_thefrog/?hl=en" class="text-white me-3">Instagram</a>
          <a href="https://www.tiktok.com/@fric_thefrog" class="text-white">TikTok</a>
        </div>
      </div>

    </div>

    <hr class="border-light">

    <p class="text-center mb-0 text-white">2026 Fricshop.com All rights reserved.</p>
  </div>
</footer>

<script src="/vendor/bootstrap.bundle.min.js"></script>

<script>
document.getElementById("signupForm").addEventListener("submit", function(event) {
    const password = document.getElementById("signupPassword").value;
    const confirmPassword = document.getElementById("signupConfirm").value;

    if (password !== confirmPassword) {
        event.preventDefault();
        alert("Passwords do not match!");
    }
});
</script>

</body>
</html>
